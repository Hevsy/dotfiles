# Template for ~/.ssh/config.local - copy this to ~/.ssh/config.local and
# fill in real values. That file is gitignored (see MIGRATION.md secrets
# bundle) and included by the tracked config via `Include config.local`.
#
# cp ~/dotfiles/.ssh/config.local.example ~/.ssh/config.local

Host syd-temp
  HostName 203.0.113.10
  User ec2-user
  IdentityFile ~/.ssh/pp_rdc_v3
