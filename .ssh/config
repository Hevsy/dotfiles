# Real server shorthands (IPs, keys) live in config.local, which is
# untracked/gitignored - this repo is public, that file isn't. See
# config.local.example for the format; config.local also rides along in the
# encrypted secrets bundle described in MIGRATION.md since it's under ~/.ssh.
Include config.local

# GitLab.com
Host gitlab.com
  PreferredAuthentications publickey
  IdentityFile ~/.ssh/pp_rdc_v3
