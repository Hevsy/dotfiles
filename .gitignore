# Vim/Neovim cache/history, not config - regenerates itself, grows forever,
# and is machine/session-specific (was mistakenly tracked since the first commit).
.viminfo

# opencode plugin-dev sandbox under .config/opencode - reinstallable, not config.
.config/opencode/node_modules/
.config/opencode/package-lock.json
.config/opencode/bun.lock

# rclone's config holds the Google OAuth token - never committed, even
# defensively, since this repo's layout doesn't stow anything under
# .config/rclone (see backup/gdrive-backup.sh for why).
.config/rclone/
rclone.conf
